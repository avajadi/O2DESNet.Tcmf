<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Version>0.1.0-preview.1</Version>
    <Description>Generate Transport Collaboration Messaging Format (TCMF 0.0.7) messages from O2DESNet discrete-event simulations.</Description>
    <PackageTags>O2DESNet;TCMF;Discrete-Event Simulation;Digital Twin;Transport</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- The core package carries the repository README. -->
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="O2DESNet" Version="3.7.2" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

</Project>
